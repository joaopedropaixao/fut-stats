{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=@fut-stats/web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "futstats-app.com.br" }],
      "destination": "https://fut-stats-api-2qh1.onrender.com/api/:path*"
    },
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "fut-stats-app.vercel.app" }],
      "destination": "https://fut-stats-api-2qh1.onrender.com/api/:path*"
    },
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "^fut-stats-app-[a-z0-9-]+\\.vercel\\.app$" }],
      "destination": "https://fut-stats-api-2qh1.onrender.com/api/:path*"
    },
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "fut-stats-three.vercel.app" }],
      "destination": "https://fut-stats-api-staging.onrender.com/api/:path*"
    },
    {
      "source": "/api/:path*",
      "has": [{ "type": "host", "value": "^fut-stats-[a-z0-9-]+\\.vercel\\.app$" }],
      "destination": "https://fut-stats-api-staging.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
