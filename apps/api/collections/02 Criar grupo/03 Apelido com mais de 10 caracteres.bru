meta {
  name: Apelido com mais de 10 caracteres
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/groups
  body: json
  auth: none
}

headers {
  Cookie: {{ownerCookie}}
}

body:json {
  {
    "name": "Pelada Erro",
    "nickname": "Apelidao123",
    "primaryPosition": "DEFENDER"
  }
}

tests {
  test("status 400", function () {
    expect(res.status).to.equal(400);
  });

  test("aponta o campo nickname", function () {
    expect(res.body.message).to.equal("Dados inválidos");
    const paths = res.body.issues.map((i) => i.path);
    expect(paths).to.include("nickname");
  });
}
