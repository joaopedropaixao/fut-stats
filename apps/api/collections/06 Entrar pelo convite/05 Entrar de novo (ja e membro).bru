meta {
  name: Entrar de novo (ja e membro)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/invites/{{inviteCode}}/join
  body: json
  auth: none
}

headers {
  Cookie: {{joinerCookie}}
}

body:json {
  {
    "nickname": "Outro",
    "primaryPosition": "GOALKEEPER"
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("formato do grupo", function () {
    expect(res.body).to.have.all.keys("id", "name", "slug", "role", "memberCount");
    expect(res.body.id).to.be.a("string");
    expect(res.body.slug).to.be.a("string");
  });

  test("devolve o grupo sem duplicar", function () {
    expect(res.body.id).to.equal(bru.getVar("groupId"));
    expect(res.body.role).to.equal("PLAYER");
    expect(res.body.memberCount).to.equal(2);
  });
}
