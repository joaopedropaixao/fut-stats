meta {
  name: Ver de novo devolve o mesmo codigo
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/groups/{{groupId}}/invite
  body: none
  auth: none
}

headers {
  Cookie: {{ownerCookie}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("mesmo código", function () {
    expect(res.body.code).to.equal(bru.getVar("inviteCode"));
  });
}
