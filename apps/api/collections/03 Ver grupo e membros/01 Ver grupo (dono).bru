meta {
  name: Ver grupo (dono)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/groups/{{groupId}}
  body: none
  auth: none
}

headers {
  Cookie: {{ownerCookie}}
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });

  test("formato do grupo", function () {
    expect(res.body).to.have.all.keys("id", "name", "slug", "role", "memberCount");
    expect(res.body.id).to.be.a("string");
    expect(res.body.slug).to.be.a("string");
  });

  test("dados do grupo", function () {
    expect(res.body.id).to.equal(bru.getVar("groupId"));
    expect(res.body.name).to.equal(bru.getVar("groupName"));
    expect(res.body.role).to.equal("ADMIN");
    expect(res.body.memberCount).to.equal(1);
  });
}
