# Ambiente: development, test ou production (padrão). Fora de development/test o cookie de sessão é Secure.
NODE_ENV=development

# Porta HTTP da API
PORT=3000

# Postgres (docker compose up -d sobe este banco na porta 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fut_stats

# Conexão direta só para as migrations (prisma.config.ts). Local: não precisa, vale a DATABASE_URL.
# Staging/produção (Neon): a URL sem "-pooler"; a DATABASE_URL fica com a URL com pooling.
# DIRECT_URL=

# Segredo que assina o JWT da sessão (mínimo 32 caracteres). Gere um com: openssl rand -base64 48
# Trocar o valor desloga todo mundo.
JWT_SECRET=troque-este-valor-por-um-segredo-de-verdade

# Quantos dias a sessão vale depois do login (padrão 30).
# SESSION_TTL_DAYS=30

# Login com Google: client OAuth "Web application" do projeto fut-stats no Google Cloud (ver docs/deploy.md).
# Os valores de verdade só no .env (nunca em commit).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Endereço do app no navegador (o Vite em dev). A callback do Google é ${APP_URL}/api/auth/google/callback
# e precisa estar cadastrada no Google Cloud.
APP_URL=http://localhost:5173
