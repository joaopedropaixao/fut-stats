// Schema do banco (Fase 1: núcleo do grupo).
// Enums em inglês, iguais aos de packages/domain/src/core (src/prisma/domain-enums.spec.ts garante).
// Todo dado de domínio pertence a um grupo: direto (Membership, Round) ou via Round.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Papel do usuário num grupo. Admin também é jogador, com permissões a mais.
enum Role {
  ADMIN
  PLAYER
}

/// Igual a `Position` do domain (formação 1-2-3-1).
enum Position {
  GOALKEEPER
  DEFENDER
  WINGER
  MIDFIELDER
  FORWARD
}

/// Igual a `Team` do domain: Branco x Preto.
enum Team {
  WHITE
  BLACK
}

/// Ciclo da rodada: agendada → times publicados → em jogo → Resenha pós-jogo → votação → encerrada.
enum RoundStatus {
  SCHEDULED
  TEAMS_PUBLISHED
  IN_PROGRESS
  POST_MATCH
  VOTING
  CLOSED
}

/// Por que a votação fechou. Igual a `VotingEndReason` do domain.
enum VotingEndReason {
  ALL_VOTED
  DEADLINE_PASSED
  ADMIN_CLOSED
}

/// Tipo de lance registrado na rodada. Igual a `MatchEventType` do domain.
/// OWN_GOAL = gol contra: fica com quem fez e conta no placar do adversário.
/// Gols sofridos não são lance: saem do placar (gols do time adversário).
enum MatchEventType {
  GOAL
  ASSIST
  OWN_GOAL
}

/// Ações do registro de auditoria. Igual a `ROUND_LOG_ACTIONS` + `FEED_LOG_ACTIONS` do domain.
enum AuditAction {
  // Rodada
  TEAMS_PUBLISHED
  TEAMS_UNPUBLISHED
  MATCH_STARTED
  SCORE_SET
  MATCH_FINISHED
  VOTING_OPENED
  VOTING_CLOSED
  EVENT_LAUNCHED
  EVENT_REMOVED
  // Feed
  POST_CREATED
  POST_EDITED
  POST_DELETED
  COMMENT_CREATED
  COMMENT_DELETED
  REACTION_SET
  REACTION_REMOVED
}

/// Tom de pele do bonequinho. Igual a `AvatarSkin` do domain (do mais claro ao mais escuro).
enum AvatarSkin {
  LIGHT
  FAIR
  TAN
  BROWN
  DARK
}

/// Estilo de cabelo do bonequinho. Igual a `AvatarHair` do domain; careca ignora a cor.
enum AvatarHair {
  BALD
  SHORT
  CURLY
  AFRO
  LONG
  MOHAWK
}

/// Cor do cabelo do bonequinho. Igual a `AvatarHairColor` do domain.
enum AvatarHairColor {
  BLACK
  BROWN
  BLOND
  RED
  GRAY
}

/// Reação a uma resenha do Feed. Igual a `PostReaction` do domain (bola, bagre, OSS!, cartão amarelo, pipocou).
enum PostReactionType {
  BALL
  CATFISH
  OSS
  YELLOW_CARD
  POPCORN
}

/// Pessoa que faz login (Google). Não tem dado de pelada: isso fica na Membership de cada grupo.
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  avatarUrl String?
  googleId  String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
}

/// Uma pelada. Só entra quem tem o link de convite.
model Group {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  inviteCode          String   @unique @default(cuid())
  /// Prazo da votação, em horas contadas de quando o admin abriu (Round.votingOpenedAt).
  votingDeadlineHours Int      @default(24)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  memberships Membership[]
  rounds      Round[]
  posts       Post[]
  auditLogs   AuditLog[]
}

/// Um usuário dentro de um grupo: papel e dados de jogador daquele grupo.
model Membership {
  id                 String          @id @default(cuid())
  userId             String
  groupId            String
  role               Role            @default(PLAYER)
  nickname           String
  photoUrl           String?
  primaryPosition    Position
  secondaryPositions Position[]
  /// Nota de 0 a 10 (passo 0,5) definida pelo admin no cadastro; validada na borda.
  initialRating      Float
  /// Goleiro contratado por fora (não paga mensalidade). Dado de cadastro, não muda as regras.
  isHiredGoalkeeper  Boolean         @default(false)
  /// Desativar em vez de apagar: o histórico de rodadas continua apontando para a membership.
  active             Boolean         @default(true)
  /// Bonequinho pixel do jogador naquela pelada (o rosto dele no app). Padrão = `DEFAULT_AVATAR` do domain.
  avatarSkin         AvatarSkin      @default(TAN)
  avatarHair         AvatarHair      @default(SHORT)
  avatarHairColor    AvatarHairColor @default(BLACK)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  user            User           @relation(fields: [userId], references: [id])
  group           Group          @relation(fields: [groupId], references: [id])
  attendances     Attendance[]
  teamPlayers     TeamPlayer[]
  matchEvents     MatchEvent[]   @relation("MatchEventPlayer")
  eventsLogged    MatchEvent[]   @relation("MatchEventCreatedBy")
  /// Votos que deu (o pacote), os que o escolheram Craque e Perna de Pau e as notas que recebeu.
  votesCast       Vote[]         @relation("VoteVoter")
  votesAsMvp      Vote[]         @relation("VoteMvp")
  votesAsFlop     Vote[]         @relation("VoteFlop")
  ratingsReceived Rating[]
  /// Resenhas que escreveu (admin), as reações que deu e os comentários que fez.
  posts           Post[]
  postReactions   PostReaction[]
  postComments    PostComment[]
  auditLogs       AuditLog[]

  @@unique([userId, groupId])
  @@index([groupId])
}

/// Encontro semanal = uma partida Branco x Preto.
model Round {
  id                String           @id @default(cuid())
  groupId           String
  /// Número da rodada no grupo (1, 2, 3...), "RODADA 12". Quem preenche é o banco: um trigger
  /// (migration round_number) grava o maior número do grupo + 1 em todo insert; o 0 do default
  /// nunca fica salvo. Apagar a última rodada libera o número; apagar outra deixa um buraco.
  number            Int              @default(0)
  scheduledAt       DateTime
  location          String?
  status            RoundStatus      @default(SCHEDULED)
  /// Placar: nulo até o admin lançar.
  whiteGoals        Int?
  blackGoals        Int?
  /// Quando a rodada entrou em votação (o `openedAt` dela). Nulo antes; gravado no open-voting.
  votingOpenedAt    DateTime?
  /// Quando a votação fechou e por quê; nulos até fechar (`CLOSED`). O resultado fica gravado no `TeamPlayer`.
  closedAt          DateTime?
  votingEndReason   VotingEndReason?
  /// Instante em que o rodízio compartilhado começou; nulo quando está desligado.
  rotationStartedAt DateTime?
  /// Duração escolhida para o rodízio, em minutos; nulo quando está desligado.
  rotationMinutes   Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  group       Group        @relation(fields: [groupId], references: [id])
  attendances Attendance[]
  teamPlayers TeamPlayer[]
  matchEvents MatchEvent[]
  votes       Vote[]
  auditLogs   AuditLog[]

  @@unique([groupId, number])
  @@index([groupId, scheduledAt])
}

/// Resposta de presença de um membro numa rodada. Sem linha = ainda não respondeu.
model Attendance {
  id           String   @id @default(cuid())
  roundId      String
  membershipId String
  confirmed    Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  round      Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id])

  @@unique([roundId, membershipId])
}

/// Jogador escalado num time da rodada (titular ou reserva). Quem está aqui jogou.
model TeamPlayer {
  id           String   @id @default(cuid())
  roundId      String
  membershipId String
  team         Team
  position     Position
  /// Reserva entra no revezamento e conta como tendo jogado.
  isReserve    Boolean  @default(false)
  /// Resultado da rodada, gravado ao fechar a votação e que não muda mais: nota (nula = ninguém deu),
  /// quantas notas recebeu e se levou Craque e Perna de Pau.
  roundScore   Float?
  ratingsCount Int      @default(0)
  isMvp        Boolean  @default(false)
  isFlop       Boolean  @default(false)
  createdAt    DateTime @default(now())

  round      Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id])

  /// Um jogador está em um só time por rodada.
  @@unique([roundId, membershipId])
}

/// Um lance da rodada (scout). Guarda quem fez e quem lançou.
model MatchEvent {
  id           String         @id @default(cuid())
  roundId      String
  /// Quem fez o lance.
  membershipId String
  type         MatchEventType
  /// Quem lançou: o próprio jogador ou um admin.
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  round      Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  membership Membership @relation("MatchEventPlayer", fields: [membershipId], references: [id])
  createdBy  Membership @relation("MatchEventCreatedBy", fields: [createdById], references: [id])

  @@index([roundId])
}

/// O voto de um jogador na rodada: um pacote (notas de todos + Craque + Perna de Pau). Enviar de novo troca tudo.
/// Anônimo: nenhuma rota devolve quem votou em quem.
model Vote {
  id        String   @id @default(cuid())
  roundId   String
  voterId   String
  /// Craque.
  mvpId     String
  /// Perna de Pau.
  flopId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  round   Round      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  voter   Membership @relation("VoteVoter", fields: [voterId], references: [id])
  mvp     Membership @relation("VoteMvp", fields: [mvpId], references: [id])
  flop    Membership @relation("VoteFlop", fields: [flopId], references: [id])
  ratings Rating[]

  /// Um pacote por votante por rodada.
  @@unique([roundId, voterId])
}

/// Uma nota de um pacote de votos: 0 a 10, de 0,5 em 0,5 (validada na borda e no domain).
model Rating {
  id       String @id @default(cuid())
  voteId   String
  targetId String
  value    Float

  vote   Vote       @relation(fields: [voteId], references: [id], onDelete: Cascade)
  target Membership @relation(fields: [targetId], references: [id])

  @@unique([voteId, targetId])
  @@index([targetId])
}

/// Resenha do Feed: texto que um admin escreve para o grupo (só texto na v1). O autor pode ficar inativo e a
/// resenha continua com o nome dele. Apagar a resenha apaga reações e comentários.
model Post {
  id        String    @id @default(cuid())
  groupId   String
  authorId  String
  /// Opcional, até 60 caracteres (validado na borda e no domain).
  title     String?
  /// Até 1000 caracteres, com quebra de linha.
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Quando um admin editou; nulo = nunca editada.
  editedAt  DateTime?

  group     Group          @relation(fields: [groupId], references: [id])
  author    Membership     @relation(fields: [authorId], references: [id])
  reactions PostReaction[]
  comments  PostComment[]

  @@index([groupId, createdAt])
}

/// A reação de um membro a uma resenha: uma por pessoa (trocar = sobrescrever, tirar = apagar a linha).
model PostReaction {
  postId       String
  membershipId String
  reaction     PostReactionType
  createdAt    DateTime         @default(now())

  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id])

  @@id([postId, membershipId])
}

/// Comentário de um membro numa resenha: até 280 caracteres, sem edição.
model PostComment {
  id           String   @id @default(cuid())
  postId       String
  membershipId String
  text         String
  createdAt    DateTime @default(now())

  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id])

  @@index([postId, createdAt])
}

/// Registro de auditoria do grupo: quem fez o quê e quando (rodada e feed). Só inserção, na mesma transação da
/// mudança. Voto e rodízio ficam de fora. Interno: o admin lê o da rodada pela API; o do feed, só o dono, no banco.
/// Apagar a rodada apaga as linhas dela (cascade); apagar a resenha NÃO apaga as dela (`postId` sem chave
/// estrangeira, senão ninguém descobre quem apagou).
model AuditLog {
  id        String      @id @default(cuid())
  groupId   String
  /// Linhas da rodada; nulo nas do feed.
  roundId   String?
  /// Linhas do feed; nulo nas da rodada. Sem chave estrangeira de propósito.
  postId    String?
  /// Quem fez; nulo = automático (fechamento da votação sem pedido do admin).
  actorId   String?
  action    AuditAction
  /// Retrato pequeno de antes e de depois, por ação (ver o spec auditoria-da-rodada).
  before    Json?
  after     Json?
  /// `x-request-id` do pedido que gerou a linha; nulo quando não há pedido (relógio da votação).
  requestId String?
  createdAt DateTime    @default(now())

  group Group       @relation(fields: [groupId], references: [id])
  round Round?      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  actor Membership? @relation(fields: [actorId], references: [id])

  @@index([roundId, createdAt])
  @@index([groupId, createdAt])
  @@index([postId, createdAt])
  @@index([requestId])
  @@index([actorId, createdAt])
}
