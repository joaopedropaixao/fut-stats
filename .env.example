# Um .env só, na raiz do repositório: a API, o Prisma e o Vite leem daqui.

# ── API ──────────────────────────────────────────────────────────────────────

# Ambiente: development, test ou production (padrão). Fora de development/test o cookie de sessão é Secure.
NODE_ENV=development

# Porta HTTP da API
PORT=3000

# Postgres (docker compose up -d sobe este banco na porta 5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fut_stats

# Conexão direta só para as migrations (prisma.config.ts). Local: não precisa, vale a DATABASE_URL.
# Staging/produção (Neon): a URL sem "-pooler"; a DATABASE_URL fica com a URL com pooling.
# DIRECT_URL=

# Segredo que assina o JWT da sessão (mínimo 32 caracteres). Gere um com: openssl rand -base64 48
# Trocar o valor desloga todo mundo.
JWT_SECRET=troque-este-valor-por-um-segredo-de-verdade

# Quantos dias a sessão vale depois do login (padrão 30).
# SESSION_TTL_DAYS=30

# De quantos em quantos milissegundos a API fecha votações com o prazo vencido (padrão 60000 = 1 minuto; 0 desliga).
# Também fecha no último voto e ao abrir o app depois do prazo. Em produção o despertador chama o mesmo fechamento.
# VOTING_CLOSER_INTERVAL_MS=60000

# Intervalo do pulso do canal ao vivo da rodada, em ms (padrão 20000). Mantém a conexão aberta atrás de proxy.
# STREAM_HEARTBEAT_MS=20000

# Login com Google: client OAuth "Web application" do projeto fut-stats no Google Cloud (ver docs/deploy.md).
# Os valores de verdade só no .env (nunca em commit).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Endereço do app no navegador (o Vite em dev). A callback do Google é ${APP_URL}/api/auth/google/callback
# e precisa estar cadastrada no Google Cloud.
APP_URL=http://localhost:5173

# Avisos push (Web Push): as três juntas ou nenhuma. Vazias, o push fica desligado (o app some com o card de avisos)
# e nenhuma ação tenta enviar. Gere o par com: npx web-push generate-vapid-keys (ver docs/deploy.md).
# A privada é segredo: só no .env, nunca em commit. O subject é o contato do dono (mailto: ou https://).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Sentry da API (só staging e produção; em dev deixe comentado e o Sentry nem é iniciado). O DSN vem do projeto da API
# no Sentry (ver docs/deploy.md). SENTRY_ENVIRONMENT etiqueta os eventos: staging ou production (padrão: NODE_ENV).
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=

# Despertador (só na produção): segredo do POST /api/internal/tick, que o GitHub Actions chama de 30 em 30 minutos para
# fechar votações vencidas. Mínimo de 32 caracteres; gere com: openssl rand -base64 48. Sem ele a rota não existe (404).
# TICK_SECRET=

# ── Web ──────────────────────────────────────────────────────────────────────

# Para onde o Vite (em dev) encaminha as chamadas /api/*
API_PROXY_TARGET=http://localhost:3000

# Porta do Vite (padrão 5173; se definida, não cai em outra). Só entra no .env.equipe, ver abaixo.
# WEB_PORT=5173

# Sentry do web (só no build da Vercel; sem ele nada do Sentry é baixado). Ver docs/deploy.md.
# VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=

# ── Modo paralelo ────────────────────────────────────────────────────────────

# Duas equipes rodando ao mesmo tempo precisam de portas e banco próprios. Cada worktree então ganha, na raiz,
# um .env.equipe (fora do git) só com o que muda: PORT, WEB_PORT, APP_URL, API_PROXY_TARGET, DATABASE_URL e
# DIRECT_URL (o mesmo valor da DATABASE_URL). Ele vence o .env; o que não estiver nele vem do .env.
# Nunca ponha segredo nele: quem lê esse arquivo são os agentes.
